# Nexus Panel backend configuration.
# Copy this file to .env and fill in your values.
# Every variable is optional unless marked Required.

# Required: strong random secret used for session/token signing.
# Generate one with: openssl rand -hex 32
NEXUS_SECRET_KEY=change-me-to-a-random-secret

# Bind address and port of the API server.
NEXUS_HOST=0.0.0.0
NEXUS_PORT=8000

# development or production. Production disables interactive API docs and
# enables stricter error handling.
NEXUS_ENV=production

# SQLite database location (relative to the backend working directory).
NEXUS_DATABASE_URL=sqlite:///./data/nexus.db

# Web session lifetime in minutes (default 1440 = 24 hours).
NEXUS_SESSION_LIFETIME_MINUTES=1440

# Admin elevation lifetime in minutes. 0 means admin mode never expires
# until revoked manually.
NEXUS_ADMIN_SESSION_LIFETIME_MINUTES=0

# Allowed CORS origins, comma-separated. Use the origin users type into
# their browser to reach the panel.
NEXUS_CORS_ORIGINS=http://localhost:8000,http://192.0.2.10:8000

# Comma-separated list of systemd services the panel may manage.
NEXUS_SERVICE_ALLOWLIST=nginx,postgresql

# Shell used by the interactive web terminal.
NEXUS_TERMINAL_SHELL=/bin/bash

# Enable the interactive WebSocket terminal (true/false).
NEXUS_TERMINAL_ENABLED=true

# Maximum concurrent terminal sessions per user.
NEXUS_TERMINAL_MAX_SESSIONS_PER_USER=2

# File manager sandbox root. All non-privileged file operations stay below
# this directory. When running as the dedicated nexus user this should be
# that user's home directory.
NEXUS_FILES_ROOT=/home/nexus
